                                      # functions start at a 2-mod-4 address, so a
                                      # 4-byte floor would push every Thumb function
                                      # two bytes past its measured address.  Each
                                      # placed object has its declared .text align-
                                      # ment relaxed to the natural alignment of its
                                      # measured address, so the linker never re-
                                      # aligns a span away from its placement.
        . = 0x02000000;                  # .text start (section table)
