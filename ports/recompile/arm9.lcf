# ==================================================================================================
# ports/recompile/arm9.lcf -- whole-image ARM9 linker command file
# ==================================================================================================
#
# GENERATED FILE.  Regenerate with:
#     python public_tools/whole_image_link.py --root . --emit-lcf
# and verify it is current with:
#     python public_tools/whole_image_link.py --root . --check-lcf
#
# Every address, length and alignment below is derived; nothing is typed by hand.
#
#   section table     config/arm9/delinks.txt
#                     sha256 87227bc99409b8086d31333f2f6fff30f4b0614aa51298eece9ec8bb7f2a91f0
#   module header     extract/arm9/arm9.yaml  (base_address, bss_start, bss_end)
#   function spans    ledger/functions.jsonl  (address + size per function)
#   symbol addresses  config/arm9/symbols.txt  (absolute symbol carrier)
#   dialect           the `dsd lcf` output dsd 0.12.1 generates for this project,
#                     which is the Metrowerks LCF dialect the pinned mwldarm accepts:
#                     `MEMORY { R : ORIGIN = 0x.. > file }`, `AFTER(..)`,
#                     `SECTIONS { .name : { ... } > R }`, `ALIGNALL(n)`,
#                     `. = ALIGN(n)`, `. = 0xADDR`, `WRITEW(v)`, `SYM = .`,
#                     `ADDR(R)`, `SIZEOF(R)`, `KEEP_SECTION`, `* (.section)` and
#                     `object.o (.section)` placement.
#
# The ARM9 region is written straight to a flat binary by mwldarm, so the link
# product is the module image itself, not an ELF a second tool must convert.
#
# Run it from the directory the objects live in, because a Metrowerks command file
# can only name an input object by bare file name (a path separator makes the
# parser report "File not found: build"):
#     cd build/whole-image
#     mwldarm -nostdlib -nodeadstrip @objects.rsp
# `public_tools/whole_image_link.py` does exactly that; this file is its output.
#
# Measured layout (from the section table, .text/.rodata/.ctor/.data/.bss order):
#   .text     0x02000000 .. 0x020d3fe0   868320 bytes  kind=code   align=32
#   .rodata   0x020d3fe0 .. 0x020dcb30    35664 bytes  kind=rodata align=4
#   .ctor     0x020dcb30 .. 0x020dcb30        0 bytes  kind=rodata align=4
#   .data     0x020dcb40 .. 0x020e3300    26560 bytes  kind=data   align=32
#   .bss      0x020e3300 .. 0x021d7240   999232 bytes  kind=bss    align=32
#
# The initialised image is .text through .data: 0x02000000 .. 0x020e3300 = 930560 bytes,
# which is the size of extract/arm9/arm9.bin and the length the region file gets.
#
# Absolute placements: 4671 reconstructed spans.
# Each span is `. = <measured address>; <object>(.text)`.  A function with no
# reconstructed source is not placed at all: the linker leaves zero bytes in the
# hole, the next span keeps its absolute address, and the diff reports the hole.
# Nothing is copied from the image, so a hole cannot fake a match.
#
# ==================================================================================================

MEMORY {
    # The whole initialised main module, written as a flat binary.  ORIGIN is the
    # .text start from the section table; the length is fixed by the final
    # `. = 0x020e3300` in .arm9, which is the .data end / .bss start.
    ARM9 : ORIGIN = 0x02000000 > arm9.bin
    # .bss is not part of the initialised image, so its region names no output file:
    # mwldarm reserves the address window and writes nothing for it.
    BSS  : ORIGIN = 0x020e3300
}

KEEP_SECTION {
    .init,
    .ctor,
    .exceptix
}

SECTIONS {
    # Linker-defined bounds, so a startup or a checker can read them without hard-
    # coding anything: every value is an address from the section table.
    __ARM9_LO        = 0x02000000;   # .text start
    __ARM9_TEXT_HI   = 0x020d3fe0;   # .text end
    __ARM9_RODATA_LO = 0x020d3fe0;   # .rodata start
    __ARM9_DATA_LO   = 0x020dcb40;   # .data start
    __ARM9_BSS_LO    = 0x020e3300;   # .bss start
    __ARM9_HI        = 0x021d7240;   # .bss end

